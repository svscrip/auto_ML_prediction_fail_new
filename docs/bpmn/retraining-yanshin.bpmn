<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Yanshin" targetNamespace="https://github.com/svscrip/auto_ML_prediction_fail_new/yanshin" exporter="bpmn-js / bpmn-auto-layout">
  <bpmn:process id="Process_Retraining" name="Переобучение модели — Яньшин А." isExecutable="false">
    <bpmn:documentation>Учебная спецификация. Основа — групповой проект. Роли, условия и артефакты: Model_retrain_BPMN.md. Это проектируемый процесс, внешние интеграции ещё не реализованы.</bpmn:documentation>
    <bpmn:startEvent id="Start" name="Триггер: drift / quality / расписание / вручную">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Capture" name="Зафиксировать champion; attempt = 0">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Data" name="Получить размеченный snapshot">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Ready" name="Данные готовы?" default="Flow_5">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Prepare" name="Разделение и признаки без утечки">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Train" name="attempt += 1; обучить candidate">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Compare" name="Оценить обе модели на одном snapshot">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate" name="AUC лучше; ограничения соблюдены?" default="Flow_11">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Retry" name="attempt &lt; 3; причина устранима?" default="Flow_13">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Revise" name="DS: анализ и новая конфигурация">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Review" name="Валидатор и владелец: проверить отчёт">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Approved" name="Одобрено?" default="Flow_18">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Register" name="Зарегистрировать неизменяемую версию">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Deploy" name="Проверить champion; тестовый rollout">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Health" name="Проверки успешны?" default="Flow_24">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Promote" name="Переключить champion; архивировать прежний">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Rollback" name="Откат и проверка; иначе регламентный режим">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Stop" name="Сохранить champion; анализ / эскалация">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Notify" name="Аудит и Telegram; при сбое очередь">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="Цикл закрыт; мониторинг продолжается">
      <bpmn:incoming>Flow_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="TrainError" name="Ошибка обучения" attachedToRef="Train">
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:errorEventDefinition id="TrainError_Definition" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="RegisterError" name="Ошибка регистрации" attachedToRef="Register">
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:errorEventDefinition id="RegisterError_Definition" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="DeployError" name="Ошибка деплоя" attachedToRef="Deploy">
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:errorEventDefinition id="DeployError_Definition" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timeout" name="24 часа без ответа" attachedToRef="Review">
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timeout_Definition">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="Start" targetRef="Capture" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="Capture" targetRef="Data" />
    <bpmn:sequenceFlow id="Flow_3" name="" sourceRef="Data" targetRef="Ready" />
    <bpmn:sequenceFlow id="Flow_4" name="Да" sourceRef="Ready" targetRef="Prepare">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">data_ready</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" name="Нет" sourceRef="Ready" targetRef="Stop" />
    <bpmn:sequenceFlow id="Flow_6" name="" sourceRef="Prepare" targetRef="Train" />
    <bpmn:sequenceFlow id="Flow_7" name="" sourceRef="Train" targetRef="Compare" />
    <bpmn:sequenceFlow id="Flow_8" name="" sourceRef="TrainError" targetRef="Retry" />
    <bpmn:sequenceFlow id="Flow_9" name="" sourceRef="Compare" targetRef="Gate" />
    <bpmn:sequenceFlow id="Flow_10" name="Да" sourceRef="Gate" targetRef="Review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">quality_gate_passed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" name="Нет" sourceRef="Gate" targetRef="Retry" />
    <bpmn:sequenceFlow id="Flow_12" name="Да" sourceRef="Retry" targetRef="Revise">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">attempt &lt; 3 and remediable</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" name="Нет" sourceRef="Retry" targetRef="Stop" />
    <bpmn:sequenceFlow id="Flow_14" name="" sourceRef="Revise" targetRef="Prepare" />
    <bpmn:sequenceFlow id="Flow_15" name="" sourceRef="Review" targetRef="Approved" />
    <bpmn:sequenceFlow id="Flow_16" name="" sourceRef="Timeout" targetRef="Stop" />
    <bpmn:sequenceFlow id="Flow_17" name="Да" sourceRef="Approved" targetRef="Register">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved and decision_current</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18" name="Нет" sourceRef="Approved" targetRef="Stop" />
    <bpmn:sequenceFlow id="Flow_19" name="" sourceRef="Register" targetRef="Deploy" />
    <bpmn:sequenceFlow id="Flow_20" name="" sourceRef="RegisterError" targetRef="Stop" />
    <bpmn:sequenceFlow id="Flow_21" name="" sourceRef="Deploy" targetRef="Health" />
    <bpmn:sequenceFlow id="Flow_22" name="" sourceRef="DeployError" targetRef="Rollback" />
    <bpmn:sequenceFlow id="Flow_23" name="Да" sourceRef="Health" targetRef="Promote">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">deployment_healthy</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_24" name="Нет" sourceRef="Health" targetRef="Rollback" />
    <bpmn:sequenceFlow id="Flow_25" name="" sourceRef="Promote" targetRef="Notify" />
    <bpmn:sequenceFlow id="Flow_26" name="" sourceRef="Rollback" targetRef="Notify" />
    <bpmn:sequenceFlow id="Flow_27" name="" sourceRef="Stop" targetRef="Notify" />
    <bpmn:sequenceFlow id="Flow_28" name="" sourceRef="Notify" targetRef="End" />
  </bpmn:process>
